# ---------------------------------------------------------------------------
# MOAP Clinic HUD - environment configuration
# Copy to `.env` for local development. On Render, set these in the dashboard
# under Environment -> Environment Variables. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Public base URL of this service. Used to build links in LSL notifications
# and printable documents. No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# Supabase pooler connection string. Use the *session* pooler on port 5432 for
# long-lived servers, or the transaction pooler on 6543 for serverless.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase's pooler terminates TLS with a certificate that Node cannot verify
# against the system root store. Set to "false" to skip verification, which is
# the standard configuration for Supabase + node-postgres.
PGSSL_REJECT_UNAUTHORIZED=false

# Connection pool sizing. Keep this low on Supabase's free/shared poolers.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# --- Authentication -------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# --- Second Life / LSL bridge --------------------------------------------
# Shared secret that in-world LSL objects send in the X-Clinic-Key header.
# Generate a long random value; rotate it if a HUD is ever handed out.
LSL_API_KEY=change-me-lsl-shared-key

# Comma-separated list of allowed origins for the browser SPA. The Second Life
# MOAP browser sends Origin: null, which is allowed automatically.
CORS_ORIGINS=http://localhost:3000

# --- Seeding --------------------------------------------------------------
# Temporary password for the seeded demo staff accounts. Change before seeding
# a database that is reachable from the internet.
SEED_ADMIN_PASSWORD=ClinicTemp2026!
